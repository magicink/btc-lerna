{
  "compilerOptions": {
    "allowJs": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedModules": true,
    "skipDefaultLibCheck": true,
    "sourceMap": true,
    "target": "esnext",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules"]
}
